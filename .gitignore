# Python
__pycache__/
*.py[cod]
*.egg-info/
build/
dist/
.eggs/
*.so

# venv / runtime (root-level only: wave_mcp/runtime/ is a source package)
/.venv/
/venv/
/runtime/

# IDE / tooling
.codebuddy/
.idea/
.vscode/
.pytest_cache/

# stray local artifacts (keep examples/sample/*.fst|*.vcd as quickstart data)
/test.fst.hier

# derived caches written by wave-mcp < 1.0 next to their inputs; since
# 1.0 all derived caches live under $XDG_CACHE_HOME/wave-mcp (see
# wave_mcp/runtime/storage.py). Kept so old checkouts stay clean.
*.json.msgpack
*.wave-mcp-cache.json

# fsdb2fst local build artifacts + Verdi FsdbReader runtime (NEVER redistribute)
third_party/verdi_runtime/
third_party/fsdb2fst/fsdb2fst
third_party/fsdb2fst/*.o
third_party/fsdb2fst/*.fst
third_party/fstdumper/*.so

# offline bundle build outputs (built via deploy/, not tracked)
wave-mcp-bundle*/
*.tar.gz

# Verdi on-site test package (internal harness; source of truth is
# third_party/fsdb2fst/, this dir is a copy for machines that have Verdi)
deploy/verdi_test/

# project-level test data & reports (not published; the harnesses
# functional_verify.py / full_quality_check_all_tools.py ARE tracked)
tests/projects/
tests/reports/
tests/archive/
tests/fourstate/sim/
tests/fourstate/session/
tests/fourstate/session_ext/
tests/project_assets.txt

# fieldkit run artifacts (the tool itself IS published)
fieldkit_session/
fieldkit_report.json

# static-analysis example run artifacts
examples/static_analysis/session/

.agent

# uploaded files (temporary)
knot-uploads/

# local dev docs (not published)
dev-docs/
deploy/viewer-assets-build/
deploy/viewer-assets/
deploy/.docker-build-cache/
dist/
