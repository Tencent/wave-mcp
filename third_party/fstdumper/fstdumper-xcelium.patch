 # include  <assert.h>
 # include  <time.h>
 # include  "ivl_alloc.h"
+# include  "fst_sv_vpi.h"   /* SV object types and properties for Xcelium */
+
+/* Objects with no FST representation (memories, strings, class handles,
+ * unpacked structs, automatic variables, ...).  They are counted and
+ * reported in ONE "FST info" line per $dumpvars call instead of one
+ * "FST warning" line per object, which used to turn every regression log
+ * into "PASS with warning". */
+#define FST_NOTE_MAX 32
+static struct { char what[48]; unsigned count; } fst_notes[FST_NOTE_MAX];
+static int fst_nnotes;
+
+static void fst_note_skipped(const char *what)
+{
+      int i;
+      if (!what) what = "unknown";
+      for (i = 0; i < fst_nnotes; i++) {
+	    if (strcmp(fst_notes[i].what, what) == 0) {
+		  fst_notes[i].count++;
+		  return;
+	    }
+      }
+      if (fst_nnotes < FST_NOTE_MAX) {
+	    strncpy(fst_notes[fst_nnotes].what, what,
+	            sizeof(fst_notes[0].what) - 1);
+	    fst_notes[fst_nnotes].what[sizeof(fst_notes[0].what) - 1] = '\0';
+	    fst_notes[fst_nnotes].count = 1;
+	    fst_nnotes++;
+      }
+}
+
+static void fst_report_skipped(void)
+{
+      int i;
+      if (!fst_nnotes) return;
+      vpi_printf("FST info: $dumpvars: not dumped (no FST representation):");
+      for (i = 0; i < fst_nnotes; i++)
+	    vpi_printf("%s %s x%u", i ? "," : "", fst_notes[i].what,
+	               fst_notes[i].count);
+      vpi_printf(".\n");
+      fst_nnotes = 0;
+}
+
+/* Type of the scope whose children scan_item() is currently visiting
+ * (0 for the $dumpvars arguments themselves).  Variables declared in
+ * task / function / begin / fork scopes may be automatic: Xcelium has no
+ * value for them outside an activation ("VPI NOVALOB") and refuses
+ * value-change callbacks on them ("VPI NOAUTOCB"). */
+static PLI_INT32 scan_parent_type = 0;
+
+static int is_procedural_scope(PLI_INT32 type)
+{
+      return type == vpiTask || type == vpiFunction ||
+             type == vpiNamedBegin || type == vpiNamedFork;
+}
+
+/* Name to write into the FST for a vpiName (malloc'd).
+ * Xcelium returns an escaped identifier in source form, backslash and
+ * terminating blank included ("\a+b ").  Upstream (written for Icarus)
+ * prefixed one more backslash, giving "\\a+b ".  Write it the way
+ * Xcelium's own VCD dumper does and the way RTL tools (wave-mcp's netlist,
+ * pyslang) name it: "a+b", no backslash, no blank.  With a backslash the
+ * FST path and the netlist path of the same signal differ, so value and
+ * driver queries need two different spellings.  Any other vpiName is
+ * written as is (upstream also escaped names containing '$', which is
+ * legal in a simple identifier). */
+static char *fst_ident(const char *name)
+{
+      char *s;
+      size_t n;
+      # ifdef ICARUS_VERILOG
+      if (is_escaped_id(name)) {
+	    s = malloc(strlen(name) + 2);
+	    sprintf(s, "\\%s", name);
+	    return s;
+      }
+      return strdup(name);
+      # else
+      s = strdup(name[0] == '\\' && name[1] ? name + 1 : name);
+      n = strlen(s);
+      while (n > 1 && (s[n-1] == ' ' || s[n-1] == '\t')) s[--n] = 0;
+      return s;
+      # endif
+}
+
+/* Scope names: upstream wrote vpiName verbatim, which on Xcelium kept the
+ * backslash and the blank of an escaped instance name. */
+static char *fst_scope_ident(const char *name)
+{
+      # ifdef ICARUS_VERILOG
+      return strdup(name);
+      # else
+      return fst_ident(name);
+      # endif
+}
+
+/* Port directions of the module / interface being scanned: vpiName of the
+ * port -> FST_VD_INPUT / OUTPUT / INOUT.  Upstream declared every signal
+ * FST_VD_IMPLICIT, so FST readers (GTKWave's port icons, wave-mcp's
+ * list_signals signal_type=Port/Input/Output) could not tell ports apart.
+ * Open addressing, one table per scope; see scan_item(). */
+struct port_map {
+      char **key;
+      unsigned char *dir;
+      unsigned cap, used;   /* cap: power of two, 0 = empty */
+};
+
+static struct port_map *scan_ports = NULL;
+
+static unsigned name_hash(const char *s);
+
+static void port_map_put(struct port_map *pm, const char *name, int dir)
+{
+      unsigned i, mask;
+      if (2 * (pm->used + 1) > pm->cap) {
+	    unsigned ncap = pm->cap ? 2 * pm->cap : 32, k;
+	    char **nk = calloc(ncap, sizeof(char *));
+	    unsigned char *nd = calloc(ncap, 1);
+	    for (k = 0; k < pm->cap; k++) {
+		  if (!pm->key[k]) continue;
+		  i = name_hash(pm->key[k]) & (ncap - 1);
+		  while (nk[i]) i = (i + 1) & (ncap - 1);
+		  nk[i] = pm->key[k];
+		  nd[i] = pm->dir[k];
+	    }
+	    free(pm->key);
+	    free(pm->dir);
+	    pm->key = nk;
+	    pm->dir = nd;
+	    pm->cap = ncap;
+      }
+      mask = pm->cap - 1;
+      for (i = name_hash(name) & mask; pm->key[i]; i = (i + 1) & mask)
+	    if (strcmp(pm->key[i], name) == 0) return;
+      pm->key[i] = strdup(name);
+      pm->dir[i] = (unsigned char)dir;
+      pm->used++;
+}
+
+static int port_map_get(const struct port_map *pm, const char *name)
+{
+      unsigned i, mask;
+      if (!pm || !pm->cap) return FST_VD_IMPLICIT;
+      mask = pm->cap - 1;
+      for (i = name_hash(name) & mask; pm->key[i]; i = (i + 1) & mask)
+	    if (strcmp(pm->key[i], name) == 0) return pm->dir[i];
+      return FST_VD_IMPLICIT;
+}
+
+static void port_map_free(struct port_map *pm)
+{
+      unsigned k;
+      for (k = 0; k < pm->cap; k++) free(pm->key[k]);
+      free(pm->key);
+      free(pm->dir);
+}
+
+/* Fill `pm` from vpiPort of a module / interface instance. */
+static void collect_ports(vpiHandle scope, struct port_map *pm)
+{
+      vpiHandle it = vpi_iterate(vpiPort, scope), p;
+      while (it && (p = vpi_scan(it))) {
+	    const char *pn;
+	    int d;
+	      /* A plain wrapper can expose ports that belong to an encrypted
+	       * model; reading their name prints "ERROR: VPI AGSOPRO" once per
+	       * port, which makes a passing test fail its log check. */
+	    if (vpi_get(vpiIsProtected, p) == 1) continue;
+	    pn = vpi_get_str(vpiName, p);
+	    if (!pn) continue;
+	    switch (vpi_get(vpiDirection, p)) {
+		case vpiInput:  d = FST_VD_INPUT;  break;
+		case vpiOutput: d = FST_VD_OUTPUT; break;
+		case vpiInout:  d = FST_VD_INOUT;  break;
+		default: continue;
+	    }
+	    port_map_put(pm, pn, d);
+      }
+}
+
+/* Local names of the signals already declared in the scope being scanned.
+ * One small open-addressing hash set per scope; see scan_item(). */
+struct name_set {
+      char **slot;
+      unsigned cap;   /* power of two, 0 = not allocated yet */
+      unsigned used;
+};
+
+static struct name_set *scan_names = NULL;
+
+static unsigned name_hash(const char *s)
+{
+      unsigned h = 2166136261u;            /* FNV-1a */
+      while (*s) h = (h ^ (unsigned char)*s++) * 16777619u;
+      return h;
+}
+
+/* Returns 1 if `name` was already in the set, else adds it and returns 0. */
+static int name_set_add(struct name_set *ns, const char *name)
+{
+      unsigned i, mask;
+
+      if (!ns) return 0;
+      if (2 * (ns->used + 1) > ns->cap) {
+	    unsigned ncap = ns->cap ? 2 * ns->cap : 64, k;
+	    char **nslot = calloc(ncap, sizeof(char *));
+	    for (k = 0; k < ns->cap; k++) {
+		  char *s = ns->slot[k];
+		  if (!s) continue;
+		  i = name_hash(s) & (ncap - 1);
+		  while (nslot[i]) i = (i + 1) & (ncap - 1);
+		  nslot[i] = s;
+	    }
+	    free(ns->slot);
+	    ns->slot = nslot;
+	    ns->cap = ncap;
+      }
+      mask = ns->cap - 1;
+      for (i = name_hash(name) & mask; ns->slot[i]; i = (i + 1) & mask)
+	    if (strcmp(ns->slot[i], name) == 0) return 1;
+      ns->slot[i] = strdup(name);
+      ns->used++;
+      return 0;
+}
+
+static void name_set_free(struct name_set *ns)
+{
+      unsigned k;
+      for (k = 0; k < ns->cap; k++) free(ns->slot[k]);
+      free(ns->slot);
+      ns->slot = NULL;
+      ns->cap = ns->used = 0;
+}
+
+# ifndef ICARUS_VERILOG
+/* Port-collapsed nets.
+ *
+ * A clock or reset routed through N module ports is ONE simulated net:
+ * Xcelium's own VCD writes it once under one identifier for all N names.
+ * fstdumper used to register N value-change callbacks and write N
+ * identical value changes per edge (one measured design: 21.6M FST value
+ * changes against 1.2M in the native VCD).
+ *
+ * vpi_handle(vpiSimNet, net) gives the net after port collapsing.  The
+ * first signal of a simulated net is declared normally (one callback);
+ * every further one is declared as an FST alias of it, which costs no
+ * callback and no value data -- the same thing Icarus does with
+ * _vpiNexusId.  A variable is keyed by its own full name, so nets
+ * collapsed onto it alias it too.  Width must match.
+ * FST_NO_ALIAS=1 turns this off. */
+struct alias_ent { char *key; fstHandle h; };
+static struct alias_ent *alias_tab = NULL;
+static unsigned alias_cap = 0, alias_used = 0;
+static unsigned long fst_n_vars = 0, fst_n_alias = 0;
+static int fst_alias_on = -1;
+
+static fstHandle alias_find(const char *key)
+{
+      unsigned i, mask;
+      if (!alias_cap) return 0;
+      mask = alias_cap - 1;
+      for (i = name_hash(key) & mask; alias_tab[i].key; i = (i + 1) & mask)
+	    if (strcmp(alias_tab[i].key, key) == 0) return alias_tab[i].h;
+      return 0;
+}
+
+static void alias_put(char *key, fstHandle h)
+{
+      unsigned i, mask;
+      if (2 * (alias_used + 1) > alias_cap) {
+	    unsigned ncap = alias_cap ? 2 * alias_cap : 4096, k;
+	    struct alias_ent *nt = calloc(ncap, sizeof(*nt));
+	    for (k = 0; k < alias_cap; k++) {
+		  if (!alias_tab[k].key) continue;
+		  i = name_hash(alias_tab[k].key) & (ncap - 1);
+		  while (nt[i].key) i = (i + 1) & (ncap - 1);
+		  nt[i] = alias_tab[k];
+	    }
+	    free(alias_tab);
+	    alias_tab = nt;
+	    alias_cap = ncap;
+      }
+      mask = alias_cap - 1;
+      for (i = name_hash(key) & mask; alias_tab[i].key; i = (i + 1) & mask)
+	    if (strcmp(alias_tab[i].key, key) == 0) {
+		  free(key);
+		  return;
+	    }
+      alias_tab[i].key = key;
+      alias_tab[i].h = h;
+      alias_used++;
+}
+
+static void alias_free(void)
+{
+      unsigned k;
+      for (k = 0; k < alias_cap; k++) free(alias_tab[k].key);
+      free(alias_tab);
+      alias_tab = NULL;
+      alias_cap = alias_used = 0;
+}
+
+/* Key of the simulated object behind `item`, or NULL (no aliasing). */
+static char *alias_key(vpiHandle item, PLI_INT32 type, unsigned size)
+{
+      const char *k = NULL;
+      char *key;
+      if (fst_alias_on < 0) {
+	    const char *e = getenv("FST_NO_ALIAS");
+	    fst_alias_on = !(e && *e && strcmp(e, "0") != 0);
+      }
+      if (!fst_alias_on) return NULL;
+      switch (type) {
+	  case vpiNet:
+	  case vpiBitNet:          /* e.g. interface `input bit clk` */
+	  case vpiEnumNet:
+	  case vpiIntegerNet:
+	  case vpiPackedArrayNet:
+	  case vpiStructNet:
+	  case vpiUnionNet: {
+	    vpiHandle sn = vpi_handle(vpiSimNet, item);
+	    if (!sn) return NULL;
+	      /* the collapsed net may live inside an encrypted model: no
+	       * name (and an AGSOPRO error) there, so no alias */
+	    if ((unsigned)vpi_get(vpiSize, sn) == size &&
+	        vpi_get(vpiIsProtected, sn) != 1)
+		  k = vpi_get_str(vpiFullName, sn);
+	    key = k ? malloc(strlen(k) + 16) : NULL;
+	    if (key) sprintf(key, "%s#%u", k, size);
+	      /* one handle per dumped net: do not leak them on big designs */
+	    vpi_free_object(sn);
+	    return key;
+	  }
+	  case vpiReg:        /* == vpiLogicVar */
+	  case vpiIntegerVar:
+	  case vpiBitVar:
+	    k = vpi_get_str(vpiFullName, item);
+	    break;
+	  default:
+	    return NULL;
+      }
+      if (!k) return NULL;
+      key = malloc(strlen(k) + 16);
+      sprintf(key, "%s#%u", k, size);
+      return key;
+}
+
+/* Declared range of a plain vector net / reg, e.g. [0:7] or [8:1].
+ * IEEE 1364 makes vpiLeftRange / vpiRightRange a RELATION to an expression;
+ * Xcelium rejects them as vpi_get() properties (VPI BADPROP, printed for
+ * every object), which is why an earlier revision wrote [size-1:0]
+ * everywhere and labelled an ascending [0:7] bus as [7:0] (bit [0] then
+ * pointed at the wrong end).  Anything else (packed arrays, structs, enums, ...) keeps
+ * [size-1:0]. */
+/* 1 if a range bound can be evaluated with vpi_get_value(): constants,
+ * parameters and operations over them.  A bound containing a function
+ * call ([$clog2(N)-1:0], [f(W):0]) makes Xcelium print "ERROR: VPI
+ * EXPRWFC: Value of an expression containing a function call ... is
+ * unavailable" for every such signal, which fails the test. */
+static int range_expr_ok(vpiHandle h, int depth)
+{
+      PLI_INT32 t = vpi_get(vpiType, h);
+      vpiHandle it, o;
+      int ok = 1;
+      if (t == vpiConstant || t == vpiParameter) return 1;
+      if (t != vpiOperation || depth > 16) return 0;
+	/* bound written inside encrypted code: iterating its operands
+	 * prints "ERROR: VPI ITERPRO" */
+      if (vpi_get(vpiIsProtected, h) == 1) return 0;
+      it = vpi_iterate(vpiOperand, h);
+      while (it && (o = vpi_scan(it))) {
+	    if (!range_expr_ok(o, depth + 1)) {
+		  ok = 0;
+		  vpi_free_object(it);
+		  break;
+	    }
+      }
+      return ok;
+}
+
+static int decl_range(vpiHandle item, PLI_INT32 type, unsigned size,
+                      int *left, int *right)
+{
+      vpiHandle lh, rh;
+      s_vpi_value v;
+      int ok = 0;
+      if ((type != vpiNet && type != vpiReg) || size < 2) return 0;
+      lh = vpi_handle(vpiLeftRange, item);
+      if (!lh) return 0;
+      rh = vpi_handle(vpiRightRange, item);
+      if (rh && (!range_expr_ok(lh, 0) || !range_expr_ok(rh, 0))) {
+	    vpi_free_object(rh);
+	    rh = NULL;
+      }
+      if (rh) {
+	    v.format = vpiIntVal;
+	    vpi_get_value(lh, &v);
+	    *left = v.value.integer;
+	    v.format = vpiIntVal;
+	    vpi_get_value(rh, &v);
+	    *right = v.value.integer;
+	    ok = (unsigned)abs(*left - *right) + 1 == size;
+	    vpi_free_object(rh);
+      }
+      vpi_free_object(lh);
+      return ok;
+}
+# endif
 
