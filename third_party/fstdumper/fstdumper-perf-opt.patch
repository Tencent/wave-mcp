+/* Remember the value just written, reusing the per-signal buffer so the hot
+ * path (one call per value change of every dumped signal) never calls
+ * malloc/free.  On OOM the dedup cache is simply switched off (last_valid=0),
+ * degrading to the original "always emit" behaviour -- never to wrong output. */
+static void cache_last_str(struct vcd_info *info, const char *str)
+{
+      size_t need = strlen(str) + 1;
+
+      if (info->last_cap < need) {
+	    size_t cap = info->last_cap ? info->last_cap : 32;
+	    while (cap < need) cap *= 2;
+	    char *p = realloc(info->last_str, cap);
+	    if (!p) {
+		  info->last_valid = 0;      /* out of memory: stop dedup'ing */
+		  return;
+	    }
+	    info->last_str = p;
+	    info->last_cap = cap;
+      }
+      memcpy(info->last_str, str, need);
+      info->last_valid = 1;
+}
