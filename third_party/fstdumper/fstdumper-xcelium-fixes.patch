+++ b/testbench/fst_regress_tb.sv
@@ -0,0 +1,83 @@
+// fst_regress_tb.sv —— fstdumper 回归 testbench
+//
+// 覆盖 fstdumper 在 Xcelium 上的各条 dump 路径：
+//   * interface（含 modport / clocking block 的宿主 interface）
+//   * task / function 内的 begin 块（自动变量）
+//   * real 变量（vpiRealVar）
+//   * named event（vpiNamedEvent）
+//   * $fstDumpoff / $fstDumpon / $fstDumpall / $fstDumpflush
+//   * $finish 同刻的值变化（验证最后一次跳变不丢失）
+//
+// 运行：xrun -64bit -sv +access+r \
+//         -loadvpi ./fstdumper.so:vlog_startup_routines_bootstrap \
+//         testbench/fst_regress_tb.sv -top fst_regress_tb
+
+`timescale 1ns/1ps
+
+interface reg_if (input logic clk);
+    logic [7:0] data;
+    logic       valid;
+    clocking cb @(posedge clk);
+        output data;
+        output valid;
+    endclocking
+    modport mp (clocking cb);
+endinterface
+
+module fst_regress_tb;
+
+    logic clk = 1'b0;
+    always #5 clk = ~clk;
+
+    reg_if u_if (.clk(clk));
+
+    real        r_sig;                  // vpiRealVar
+    event       ev_sig;                 // vpiNamedEvent
+    logic [3:0] vec;
+    logic       done;
+
+    // task 内的自动变量 —— 动态 begin scope
+    task automatic do_work(input int n);
+        logic [7:0] tmp;
+        tmp = 8'(n) * 8'd3;
+        #1;
+        u_if.data  = tmp;
+        u_if.valid = 1'b1;
+        -> ev_sig;
+        #1;
+        u_if.valid = 1'b0;
+    endtask
+
+    initial begin
+        $fstDumpfile("fst_regress_tb.fst");
+        $fstDumpvars(0, fst_regress_tb);
+
+        r_sig = 0.0;
+        vec   = 4'd0;
+        done  = 1'b0;
+
+        repeat (4) begin
+            @(posedge clk);
+            r_sig = r_sig + 1.5;
+            vec   = vec + 4'd1;
+            do_work(vec);
+        end
+
+        // ---- $fstDumpoff / $fstDumpall / $fstDumpon ----
+        $fstDumpoff;                    // 之后所有信号写 x
+        @(posedge clk);
+        vec = 4'd9;
+        $fstDumpall;                    // checkpoint
+        $fstDumpon;
+        @(posedge clk);
+        vec = 4'd10;
+        $fstDumpflush;
+
+        // ---- $finish 同刻的变化（修复后必须出现在 FST 里）----
+        @(posedge clk);
+        vec  = 4'd15;
+        done = 1'b1;                    // 与 $finish 同一时刻
+        $finish;
+    end
+
+endmodule
