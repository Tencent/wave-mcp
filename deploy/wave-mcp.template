#!/usr/bin/env bash
# wave-mcp launcher (stdio). Generated by install.sh.
# Stdio mode: the MCP client spawns this as a child process -> seamless start;
# it exits automatically when the client/session closes -> seamless stop.
# Each user gets their own isolated process; the shared drive is read-only.
set -euo pipefail

BUNDLE="@BUNDLE@"
RUNTIME="@RUNTIME@"

# make the bundled vcd2fst (+ its libs) discoverable for VCD->FST conversion
if [[ -x "$BUNDLE/bin/vcd2fst" ]]; then
  export PATH="$BUNDLE/bin:$PATH"
  export VCD2FST_BIN="$BUNDLE/bin/vcd2fst"
  [[ -d "$BUNDLE/bin/lib" ]] && export LD_LIBRARY_PATH="$BUNDLE/bin/lib:${LD_LIBRARY_PATH:-}"
fi

# dispatch through the CLI entry: `wave-mcp` (no args) starts the stdio
# server; `wave-mcp query ...` runs the terminal tool surface; any other
# args go to the server parser (e.g. --transport http).
if [[ $# -eq 0 ]]; then
  exec "$RUNTIME/bin/python" -m wave_mcp.cli.main --transport stdio
else
  exec "$RUNTIME/bin/python" -m wave_mcp.cli.main "$@"
fi
